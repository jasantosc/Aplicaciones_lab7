            "def extraer_director(stars_str):\n",
            "    if \"Director\" in stars_str:\n",
            "        clean_str = stars_str.split(\"|\")[0].replace(\"Director\", \"\").replace(\"\\n\", \"\").strip()\n",
            "    else:\n",
            "        return np.nan"
         ]
      },
      {
         "cell_type": "code",
         "execution_count": 67,
         "id": "64a39335",
         "metadata": {},
         "outputs": [],
         "source": [
            "df[\"DIRECTOR\"] = df[\"STARS\"].apply(extraer_director)"
         ]
      },
      {
         "cell_type": "code",
         "execution_count": 68,
         "id": "a9a7bf78",
         "metadata": {},
         "outputs": [],
         "source": [
            "def extraer_reparto(stars_str):\n",
            "    if \"Star\" in stars_str or \"Stars\" in stars_str:\n",
            "        if \"|\" in stars_str:\n",
            "            int_str = stars_str.split(\"|\")[1]\n",
            "        else:\n",
            "            int_str = str(stars_str)\n",
            "        \n",
            "        clean_str = (int_str.replace(\"Star\", \"\")\n",
            "                 .replace(\"Stars\", \"\")\n",
            "                 .replace(\"\\n\", \"\")\n",
            "                 .strip())\n",
            "    \n",
            "        return clean_str\n",
            "    else:\n",
            "        return np.nan"
         ]
      },
