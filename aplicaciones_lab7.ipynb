         "cell_type": "code",
         "execution_count": 69,
         "id": "32a6d712",
         "metadata": {},
         "outputs": [],
         "source": [
            "df[\"STAR\"] = df[\"STARS\"].apply(extraer_reparto)"
         ]
      },
