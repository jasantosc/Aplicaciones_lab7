            "df[\"MOVIES\"] = df[\"MOVIES\"].str.strip()\n",
            "\n",
            "print(\"Nulos en RunTime: \", df[\"RunTime\"].isnull().sum())\n",
            "\n",
            "rt = df[\"RunTime\"]\n",
            "a = rt.dropna()\n",
            "b = rt.fillna(rt.mean())\n",
            "c = rt.fillna(rt.median())\n",
            "\n",
            "comparacion = pd.DataFrame({\n",
            "    \"num\": [a.count(), b.count(), c.count()],\n",
            "    \"media\": [a.mean(), b.mean(), c.mean()],\n",
            "    \"mediana\": [a.median(), b.median(), c.median()],\n",
            "    \"std\": [a.std(), b.std(), c.std()]\n",
            "}, index=[\"Borrar\", \"Media\", \"Mediana\"]).round(2)\n",
            "\n",
            "print(comparacion)\n",
            "print(comparacion)\n",
            " \n",
            "print(\"Asimetría (skew):\", round(rt.skew(), 2))\n",
            " \n",
            "\n",
            "print(\"RATING promedio (todo):\", round(df[\"RATING\"].mean(), 2))\n",
            "print(\"RATING promedio (sin nulos RunTime):\", round(df.loc[rt.notna(), \"RATING\"].mean(), 2))\n",
            "print(\"% de nulos con RATING = 0:\", round(df.loc[rt.isna(), \"RATING\"].eq(0).mean() * 100, 1))\n",
            " \n",
            "df[\"RunTime\"] = df[\"RunTime\"].fillna(rt.median()) "
         ]
